// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  samAccountName String    @unique
  fullName       String
  role           String    @default("CONFERENTE")
  lastSessionAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inventoriesCreated Inventory[] @relation("InventoryCreatedBy")
  inventoryLinks     InventoryUser[]

  @@map("users")
}

model Inventory {
  id             String   @id @default(cuid())
  name           String
  campus         String?
  sourceType     String   @default("UPLOAD_XLSX")
  statusOperacao String   @default("NAO_INICIADO")
  baseInventoryId String?
  baseInventory  Inventory? @relation("InventoryBase", fields: [baseInventoryId], references: [id], onDelete: SetNull)
  derivedInventories Inventory[] @relation("InventoryBase")
  createdById    String?
  createdBy      User?    @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  spaces         Space[]
  items          Item[]
  users          InventoryUser[]
  statusHistory  InventoryStatusHistory[]
  itemGroups     ItemGroup[]
  backupRecords  BackupRecord[]
  backupSchedule BackupSchedule?
  systemLock     SystemLock?

  @@map("inventories")
}

model InventoryStatusHistory {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  changedBy   String
  changedAt   DateTime  @default(now())

  @@index([inventoryId, changedAt])
  @@map("inventory_status_history")
}

model InventoryUser {
  id                 String   @id @default(cuid())
  inventoryId        String
  inventory          Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String   @default("CONFERENTE")
  lastVisitedSpaceId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([inventoryId, userId])
  @@index([userId])
  @@index([inventoryId])
  @@map("inventory_users")
}

model Space {
  id            String     @id @default(cuid())
  name          String
  responsible   String
  sector        String?
  unit          String?
  inventoryId   String?
  inventory     Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  isActive      Boolean    @default(true)
  isFinalized   Boolean    @default(false)
  isVerifiedByRevisor Boolean @default(false)
  startedAt     DateTime?
  startedBy     String?
  observacoes   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  items         Item[]
  lastKnownItems Item[]    @relation("ItemLastKnownSpace")
  relocationOut Relocation[] @relation("RelocationSource")
  relocationIn  Relocation[] @relation("RelocationTarget")
  historyFrom   ItemHistorico[] @relation("HistoricoFromSpace")
  historyTo     ItemHistorico[] @relation("HistoricoToSpace")
  verificationRolls VerificationRoll[]
  finalizationHistory FinalizationHistory[]
  
  @@map("spaces")
}

model Item {
  id                String     @id @default(cuid())
  patrimonio        String?
  descricao         String
  valor             Float?
  condicaoOriginal  String
  fornecedor        String?
  cnpjFornecedor    String?    @map("cnpj_fornecedor")
  catalogo          String?
  codigoSIA         String?    @map("codigo_sia")
  descricaoSIA      String?    @map("descricao_sia")
  numeroEntrada     String?    @map("numero_entrada")
  dataEntrada       DateTime?  @map("data_entrada")
  dataAquisicao     DateTime?  @map("data_aquisicao")
  documento         String?
  dataDocumento     DateTime?  @map("data_documento")
  tipoAquisicao     String?    @map("tipo_aquisicao")
  inventoryId       String?
  inventory         Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  // Identificação alternativa (livros de acervo)
  codigoBarras      String?    @map("codigo_barras")
  codigoRFID        String?    @map("codigo_rfid")
  numeroExemplar    String?    @map("numero_exemplar")
  codigoExemplar    String?    @map("codigo_exemplar")
  autores           String?
  anoPublicacao     String?    @map("ano_publicacao")

  // Dados da conferência
  spaceId           String
  space             Space      @relation(fields: [spaceId], references: [id])
  lastKnownSpaceId  String?
  lastKnownSpace    Space?     @relation("ItemLastKnownSpace", fields: [lastKnownSpaceId], references: [id], onDelete: SetNull)

  statusEncontrado  String     @default("NAO") @map("Encontrado")
  condicaoVisual    String?
  dataConferencia   DateTime?
  ultimoConferente  String?

  // Verificação (Revisor)
  verificationStatus String?   // "REVERIFICAR" during review, cleared after check
  verifiedAt        DateTime?
  verifiedBy        String?

  // Grupos
  itemGroupId       String?
  itemGroup         ItemGroup? @relation(fields: [itemGroupId], references: [id], onDelete: SetNull)

  // Relocações
  relocationIn      Relocation? @relation("ItemRelocation")
  history           ItemHistorico[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // patrimonio: NULL != NULL no PostgreSQL → múltiplos itens sem patrimônio são permitidos
  @@unique([inventoryId, patrimonio])
  // codigoBarras: cada exemplar tem código único por inventário
  @@unique([inventoryId, codigoBarras])

  @@map("items")
}

model ItemHistorico {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  fromSpaceId String?
  fromSpace   Space?   @relation("HistoricoFromSpace", fields: [fromSpaceId], references: [id], onDelete: SetNull)

  toSpaceId   String?
  toSpace     Space?   @relation("HistoricoToSpace", fields: [toSpaceId], references: [id], onDelete: SetNull)

  action      String
  reason      String?
  createdBy   String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([createdBy, createdAt])
  @@index([itemId])
  @@map("item_history")
}

model ItemGroup {
  id          String   @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([inventoryId])
  @@map("item_groups")
}

model Relocation {
  id              String   @id @default(cuid())
  itemId          String   @unique
  item            Item     @relation("ItemRelocation", fields: [itemId], references: [id], onDelete: Cascade)

  fromSpaceId     String
  fromSpace       Space    @relation("RelocationSource", fields: [fromSpaceId], references: [id])

  toSpaceId       String
  toSpace         Space    @relation("RelocationTarget", fields: [toSpaceId], references: [id])

  movedBy         String
  movedAt         DateTime @default(now())
  pendingConfirm  Boolean  @default(true)
  wasUnfound      Boolean  @default(false)

  @@map("relocations")
}

model VerificationRoll {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  itemIds     String    @default("[]")  // JSON array of selected item IDs
  selectedAt  DateTime  @default(now())
  reviewedAt  DateTime?
  result      String    @default("PENDING") // "PASSED", "FAILED", "REVERTED"
  reason      String?
  createdBy   String
  updatedAt   DateTime  @updatedAt

  @@index([spaceId])
  @@map("verification_rolls")
}

model FinalizationHistory {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  action    String   // "FINALIZED", "REVERTED_BY_REVISOR", "REVERTED_ITEM_NOT_FOUND"
  reason    String?
  actedBy   String
  actedAt   DateTime @default(now())

  @@index([spaceId])
  @@map("finalization_history")
}

model BackupRecord {
  id          String   @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdBy   String
  createdAt   DateTime @default(now())
  label       String?
  fileName    String
  filePath    String
  fileSizeBytes Int    @default(0)
  status      String   @default("COMPLETED") // "IN_PROGRESS" | "COMPLETED" | "FAILED"
  errorMessage String?
  isScheduled Boolean  @default(false)
  contentHash String?  // SHA-256 do SQL gerado; usado para deduplicação em backups agendados
  dedupCount  Int      @default(0) // nº de backups agendados idênticos que este substituiu

  @@index([inventoryId, createdAt])
  @@map("backup_records")
}

model BackupSchedule {
  id            String    @id @default(cuid())
  inventoryId   String    @unique
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  intervalHours Int
  isActive      Boolean   @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("backup_schedules")
}

model SystemLock {
  id          String    @id @default(cuid())
  inventoryId String    @unique
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  reason      String    // "BACKUP" | "RESTORE"
  lockedBy    String
  lockedAt    DateTime  @default(now())

  @@map("system_locks")
}